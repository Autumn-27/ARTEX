# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 平台回连地址:反弹 shell/隧道(内网渗透期 3/5)回连平台用;期 1a(webshell 立足点)不需要
# ARTEX_CALLBACK_ADDR=10.0.0.5:443

# 多层代理隧道(内网渗透期 3a):chisel 二进制路径(默认 data/tools/chisel,需目标同平台 linux/amd64 版本)
# ARTEX_CHISEL_PATH=/opt/artex/tools/chisel

# 反弹 shell handler(内网渗透期 5):penelope.py 路径(默认 data/tools/penelope.py)与 python 解释器
# ARTEX_PENELOPE_PATH=/usr/local/bin/penelope.py
# ARTEX_PENELOPE_PYTHON=python3

# 隧道端口池:平台侧 chisel server 监听口与 socks/转发入口都从该池分配(默认 20000-21000)
# ARTEX_TUNNEL_PORT_RANGE=20000-21000

# 按任务 MITM(期 3b):worker 流量经任务独立录制实例 → 任务隧道 socks → 内网,留痕链不断。
# 默认开;off 关闭(worker 回落全局记录代理)。实例端口池默认 21100-21199,与隧道池错开。
# ARTEX_TASK_PROXY=off
# ARTEX_TASK_PROXY_PORT_RANGE=21100-21199
