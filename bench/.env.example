# 复制为 bench/.env 后填写；docker-compose.bench.yml 通过 env_file 注入容器。
# 切勿提交真实密钥。

# 管理员密码(首次进 UI / seed 登录用)
ADMIN_PASSWORD=artexbench

# ---- LLM(腾讯 tokenhub 网关，openai 兼容格式) ----
# 双模型：planner 走强模型(plan)、worker 走弱模型(work)，共用同一网关/密钥/格式。
# 全局默认激活 = work(弱模型)，未绑定的 agent(编排等)都走它；planner/worker 各自绑定不受影响。
LLM_FORMAT=openai
LLM_MODEL_PLAN=deepseek-pro
LLM_MODEL_WORK=deepseek-flash
# 兼容旧的单一变量：若未设 LLM_MODEL_PLAN/WORK，则两者都回退到 LLM_MODEL。
LLM_MODEL=deepseek-v4-flash
# 本地测评直接用 https；托管模式改成网关形式 http://tokenhub.tencentmaas.com.tsecbench.gw/
LLM_BASE_URL=https://tokenhub.tencentmaas.com/
LLM_API_KEY=

# ---- 答题平台(TSec Benchmark) ----
# 这两个由平台在托管模式自动注入；本地测评时在这里手动填。
# 变量名必须与平台一致：BENCHMARK_BASE_URL / BENCHMARK_TOKEN。
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=
